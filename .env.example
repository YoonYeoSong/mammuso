# Supabase project settings (server-side only; never prefix these with NEXT_PUBLIC_)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SECRET_KEY=YOUR_SB_SECRET_KEY
# Legacy projects only: SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Groq API (server-side only)
GROQ_API_KEY=YOUR_GROQ_API_KEY
GROQ_MODEL=openai/gpt-oss-20b

# Privacy operations: required before public beta deployment
PRIVACY_CONTACT_EMAIL=YOUR_SUPPORT_EMAIL
OPERATOR_NAME=YOUR_LEGAL_NAME_OR_BUSINESS_NAME
PRIVACY_OFFICER_NAME=YOUR_PRIVACY_OFFICER_NAME
SUPABASE_DATA_REGION=YOUR_SUPABASE_REGION
CASE_RETENTION_DAYS=30
CRON_SECRET=GENERATE_A_RANDOM_16_PLUS_CHARACTER_STRING

# Optional: normally leave empty; invite links use the current deployed address automatically
APP_URL=

# Respondent invite safety: links expire after this many days (1–30)
RESPONDENT_INVITE_TTL_DAYS=7

# KakaoTalk Share: this JavaScript key is intentionally browser-visible.
# Register the deployed domain in both JavaScript SDK domain and Product Link management.
NEXT_PUBLIC_KAKAO_JAVASCRIPT_KEY=
