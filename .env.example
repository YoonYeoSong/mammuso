# Supabase project settings (server-side only; never prefix these with NEXT_PUBLIC_)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SECRET_KEY=YOUR_SB_SECRET_KEY
# Legacy projects only: SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Groq API (server-side only)
GROQ_API_KEY=YOUR_GROQ_API_KEY
GROQ_MODEL=openai/gpt-oss-20b

# Optional: use this for invite links outside a request context
APP_URL=https://mammuso.vercel.app
